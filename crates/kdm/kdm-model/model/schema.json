      "fields": {
        "number": { "kind": "integer", "optional": true, "readOnly": true },
        "name": { "kind": "string" },
        "color": { "kind": "json", "optional": true },
        "visible": { "kind": "boolean", "optional": true },
        "locked": { "kind": "boolean", "optional": true },
        "printable": { "kind": "boolean", "optional": true },
        "props": { "kind": "json", "optional": true }
      }
    },
