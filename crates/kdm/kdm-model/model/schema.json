        "overridden": { "kind": "list", "of": "Item" },
        "props": { "kind": "json", "optional": true }
      }
    },
    "Guide": {
      "batchOps": { "*": { "direct": true } },
      "toolId": { "field": "address" },
      "fields": {
        "address": { "kind": "string", "optional": true, "readOnly": true },
        "line": { "kind": "json" },
        "layer": { "kind": "ref", "of": "Layer", "optional": true }
      }
    },
    "Layer": {
      "batchOps": { "*": { "direct": true } },
      "label": "name",
      "toolId": { "field": "number" },
      "derived": {
        "layerItems": { "description": "the items deleting this layer would delete" },
