{
  "kdm": 1,
  "kit": "kit.layout",
  "schemaVersion": 2,
  "root": "Layout",
  "types": {
    "Layout": {
      "batchOps": { "*": { "direct": true } },
      "label": "title",
      "derived": {
        "compositionFrames": { "description": "for each story, a digest of the frame areas, options, wrap exclusions and pages its composition reads" },
        "layerCount": { "description": "number of layers used for a new layer's default name and color" },
        "layerIds": { "description": "sorted layer identities, without their order or properties" },
        "usedLayerIds": { "description": "sorted identities of layers used by top-level items on document and parent spreads" },
        "firstLayer": { "description": "first stored layer retained when deleting unused layers in an empty document" },
        "lastLayer": { "description": "last stored layer, which a page background goes on" },
        "inkAllToProcess": { "description": "effective global process-ink setting, including its default" }
      },
      "fields": {
        "title": { "kind": "string" },
        "setup": { "kind": "json", "optional": true },
        "settings": { "kind": "map" },
        "spreads": { "kind": "list", "of": "Spread" },
        "parents": { "kind": "list", "of": "Spread" },
        "layers": { "kind": "list", "of": "Layer" },
        "items": { "kind": "tree", "of": "Item" },
        "stories": { "kind": "list", "of": "Story" },
        "paragraphStyles": { "kind": "list", "of": "Style" },
        "characterStyles": { "kind": "list", "of": "Style" },
        "objectStyles": { "kind": "list", "of": "Style" },
        "tableStyles": { "kind": "list", "of": "Style" },
        "cellStyles": { "kind": "list", "of": "Style" },
        "swatches": { "kind": "list", "of": "Swatch" },
        "assets": { "kind": "list", "of": "Asset" },
        "sections": { "kind": "list", "of": "Section" },
        "opaque": { "kind": "list", "of": "Opaque" }
      }
    },
    "Spread": {
      "batchOps": { "*": { "direct": true } },
      "label": "name",
      "toolId": { "field": "number" },
      "derived": { "placeSpread": { "description": "spread identity for historical spatial evaluation" } },
      "fields": {
        "number": { "kind": "integer", "optional": true, "readOnly": true },
        "pages": { "kind": "list", "of": "Page" },
        "guides": { "kind": "list", "of": "Guide" },
        "name": { "kind": "string", "optional": true },
        "prefix": { "kind": "string", "optional": true },
        "parentLabel": { "kind": "string", "optional": true, "readOnly": true, "sample": false },
        "basedOn": { "kind": "ref", "of": "Spread", "optional": true },
        "allowShuffle": { "kind": "boolean", "optional": true }
      }
    },
    "Page": {
      "batchOps": { "*": { "direct": true } },
      "toolId": { "field": "number" },
      "derived": {
        "placeSpread": { "description": "owning spread identity for historical spatial evaluation" },
        "pageItems": { "description": "the items deleting this page would delete" }
      },
      "fields": {
        "number": { "kind": "integer", "optional": true, "readOnly": true },
        "size": { "kind": "json" },
        "margins": { "kind": "json", "optional": true },
        "columns": { "kind": "json", "optional": true },
        "parent": { "kind": "ref", "of": "Spread", "optional": true },
