      "fields": {
        "number": { "kind": "integer", "optional": true, "readOnly": true },
        "shape": { "kind": "enum", "values": [ "rectangle", "oval", "polygon", "graphicLine", "path", "group" ] },
        "content": { "kind": "enum", "values": [ "unassigned", "text", "graphic", "group" ] },
        "spread": { "kind": "ref", "of": "Spread", "optional": true, "position": true },
        "layer": { "kind": "ref", "of": "Layer", "optional": true },
        "name": { "kind": "string", "optional": true },
        "key": { "kind": "string", "optional": true, "sample": false },
